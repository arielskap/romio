namespace tests
    @suite("Photos")
    class PhotosTests extends rooibos.BaseTestSuite

        @describe("Photos_pick")

        @it("returns nothing without photos")
        function _()
            m.assertEqual(Photos_pick([], "", 0.5), "")
        end function

        @it("repeats a single photo even if it was the last one")
        function _()
            m.assertEqual(Photos_pick(["a.jpg"], "a.jpg", 0.9), "a.jpg")
        end function

        @it("never repeats the last photo when there are others")
        function _()
            m.assertEqual(Photos_pick(["a.jpg", "b.jpg"], "a.jpg", 0), "b.jpg")
            m.assertEqual(Photos_pick(["a.jpg", "b.jpg"], "a.jpg", 0.99), "b.jpg")
        end function

        @it("picks by roll when the last photo was removed")
        function _()
            m.assertEqual(Photos_pick(["a.jpg", "b.jpg", "c.jpg"], "zzz.jpg", 0.5), "b.jpg")
        end function

        @it("ignores files that are not images")
        function _()
            m.assertEqual(Photos_pick([".DS_Store", "x.txt", "p.JPG"], "", 0), "p.JPG")
        end function

    end class
end namespace
